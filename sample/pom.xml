<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.manoelcampos</groupId>
    <artifactId>java2ts-sample</artifactId>
    <!-- The version of the sample project defines the java2ts version used. -->
    <version>0.1.0</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java2ts.version>${project.version}</java2ts.version>
        <lombok.version>1.18.48</lombok.version>
        <dtogen.version>2.1.9</dtogen.version>

        <!-- JavaDocs are copied to the TypeScript file by default. Uncomment to disable it. -->
        <!-- <java2ts.javadoc>false</java2ts.javadoc> -->

        <!-- Records and final fields become readonly TypeScript properties by default. Uncomment to disable it. -->
        <!-- <java2ts.readonlyProperties>false</java2ts.readonlyProperties> -->
    </properties>

    <dependencies>
        <!-- Used just to generate getters/setters (they define the JSON/TypeScript properties) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Generates DTO records from the model classes, which are converted to TypeScript too -->
        <dependency>
            <groupId>io.github.manoelcampos</groupId>
            <artifactId>dtogen</artifactId>
            <version>${dtogen.version}</version>
        </dependency>

        <!-- JPA annotations for the entities (no JPA implementation is needed to generate TypeScript) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- Validation annotations such as @NotNull, which make TypeScript properties required -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- @Nullable annotations, which make TypeScript properties nullable -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Jackson annotations (shared by Jackson 2 and 3), such as @JsonIgnore -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.22</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <!-- Lombok needs to run before DTOGen, since the DTOs use the getters generated by Lombok. -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.github.manoelcampos</groupId>
                            <artifactId>dtogen</artifactId>
                            <version>${dtogen.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-processor</arg>
                        <arg>lombok.launch.AnnotationProcessorHider$AnnotationProcessor,io.github.manoelcampos.dtogen.DTOProcessor</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <!--
                Generates the TypeScript file after the project is compiled (mvn compile).
                Only classPatterns is required: all other settings have reasonable defaults.
                -->
                <groupId>io.github.manoelcampos</groupId>
                <artifactId>java2ts</artifactId>
                <version>${java2ts.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputFile>${project.basedir}/frontend/models.generated.ts</outputFile>
                    <classPatterns>
                        <classPattern>io.github.manoelcampos.java2ts.sample.model.**</classPattern>
                        <classPattern>io.github.manoelcampos.java2ts.sample.dto.**</classPattern>
                    </classPatterns>
                    <customTypeMappings>
                        <!-- Square brackets can be used instead of &lt; &gt; for generic type arguments.
                         Only List<List<Double>> is mapped to a tuple array: a List<List<String>> is not affected. -->
                        <mapping>java.util.List[java.util.List[java.lang.Double]]:[number, number][]</mapping>
                        <!-- Keeps the precision of BigDecimal values, when serialized as strings -->
                        <mapping>java.math.BigDecimal:string</mapping>
                    </customTypeMappings>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
